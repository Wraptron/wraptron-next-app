# Frontend environment variables (template)
#
# Copy to `.env.local` for personal overrides (ignored by git), or use the
# environment-specific files (`.env.development`, `.env.production`).

# Base URL of the backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Zoho OAuth redirect URI options (register the same URI in Zoho API console):
# - Backend: http://localhost:8000/api/zoho/oauth/callback
# - Frontend proxy: http://localhost:3000/api/zoho/oauth/callback
# Books uses ZOHO_OAUTH_SCOPES on the backend (see backend/api/.env.example).

# PostHog analytics (client + server). Project token is safe to expose on the client.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
